rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Product images directory
    match /products/{allPaths=**} {
      // Anyone can read product images for POS and catalog display
      allow read: if true;

      // Allow upload of images up to 5MB
      allow write: if request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp|gif|jpg)');
    }
  }
}
