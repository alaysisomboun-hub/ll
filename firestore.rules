rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny catch-all for undefined paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection endpoint
    match /test/{docId} {
      allow read, write: if true;
    }

    // Store settings & configuration (Public read for logo, currency, receipt format)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    // Users and staff profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if isValidId(userId);
    }

    // Products catalog
    match /products/{productId} {
      allow read: if true;
      allow write: if isValidId(productId);
    }

    // Product categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isValidId(categoryId);
    }

    // Sales transactions & Sale items
    match /sales/{saleId} {
      allow read: if true;
      allow write: if isValidId(saleId);
    }

    match /sale_items/{saleItemId} {
      allow read: if true;
      allow write: if isValidId(saleItemId);
    }

    // Customers
    match /customers/{customerId} {
      allow read: if true;
      allow write: if isValidId(customerId);
    }

    // Suppliers
    match /suppliers/{supplierId} {
      allow read: if true;
      allow write: if isValidId(supplierId);
    }

    // Purchases
    match /purchases/{purchaseId} {
      allow read: if true;
      allow write: if isValidId(purchaseId);
    }

    // Inventory transactions
    match /inventory_transactions/{transactionId} {
      allow read: if true;
      allow write: if isValidId(transactionId);
    }

    // Store expenses
    match /expenses/{expenseId} {
      allow read: if true;
      allow write: if isValidId(expenseId);
    }

    // Payment logs
    match /payments/{paymentId} {
      allow read: if true;
      allow write: if isValidId(paymentId);
    }

    // Debts ledger
    match /debts/{debtId} {
      allow read: if true;
      allow write: if isValidId(debtId);
    }

    // Store incomes
    match /incomes/{incomeId} {
      allow read: if true;
      allow write: if isValidId(incomeId);
    }

    // Finance resets & audit checkpoints
    match /finance_resets/{resetId} {
      allow read: if true;
      allow write: if isValidId(resetId);
    }
  }
}
